# AIMD (PBE-D3, NVT 300 K) of 64 waters + one excess proton (H3O+), 12.42 Å cubic cell.
# Adapted from STACC tutorial 7 (Kretchmer group). Run: see run.sbatch and README.md.
#Different sections of the input file are denoted by a line that starts with & and one that starts with &END

#GLOBAL section defines general information
&GLOBAL
    PROJECT_NAME  WATER
    RUN_TYPE MD
    WALLTIME 1800
    IOLEVEL  LOW
&END GLOBAL

#FORCE_EVAL section defines the system you want to study
#including parameters to calculate the energy and forces
&FORCE_EVAL

    #Method Quickstep corresponds to electronic structure
    METHOD Quickstep

    #DFT section as e-structure method of choice
    &DFT

        BASIS_SET_FILE_NAME HFX_BASIS
        POTENTIAL_FILE_NAME POTENTIAL

        CHARGE       1
        MULTIPLICITY 1

        &MGRID
            CUTOFF [Ry] 400
        &END

        &QS
            METHOD GPW
            EPS_DEFAULT 1.0E-10
            EXTRAPOLATION ASPC
        &END

        &POISSON
            PERIODIC XYZ
        &END

        &PRINT
            &E_DENSITY_CUBE OFF
            &END E_DENSITY_CUBE
            &MO_CUBES
                NLUMO 4
                NHOMO 4
                WRITE_CUBE .FALSE.
                &EACH
                    MD 10
                &END
            &END
        &END

        &SCF                              
            SCF_GUESS ATOMIC
            MAX_SCF 30
            EPS_SCF 1.0E-6
            &OT
                PRECONDITIONER FULL_SINGLE_INVERSE
                MINIMIZER DIIS
            &END OT
            &OUTER_SCF
                MAX_SCF 10
                EPS_SCF 1.0E-6
            &END
            &PRINT
                &RESTART OFF
                &END
            &END
        &END SCF

        #DFT specific information including exchange-correlation potential
        &XC
          &XC_FUNCTIONAL
            &PBE
            &END
          &END XC_FUNCTIONAL

          #adding Grimme's D3 correction (by default without C9 terms) 
          &VDW_POTENTIAL
             POTENTIAL_TYPE PAIR_POTENTIAL 
             &PAIR_POTENTIAL
                PARAMETER_FILE_NAME dftd3.dat
                TYPE DFTD3
                REFERENCE_FUNCTIONAL PBE
                R_CUTOFF [angstrom] 16
             &END
          &END VDW_POTENTIAL
        &END XC
    &END DFT
 
    #Section to describe the system
    &SUBSYS

        &CELL 
            ABC [angstrom] 12.42 12.42 12.42 #Size of the unit-cell
        &END CELL

        &TOPOLOGY #Location and format of the system coordinates
          COORD_FILE_NAME water.xyz
          COORD_FILE_FORMAT XYZ
        &END

        #Basis-set information
        &KIND H                              
          BASIS_SET DZVP-GTH
          POTENTIAL GTH-PBE-q1             
        &END KIND
        &KIND O
          BASIS_SET DZVP-GTH
          POTENTIAL GTH-PBE-q6
        &END KIND

    &END SUBSYS

&END FORCE_EVAL

#MD Information - the selection was originally made via RUN_TYPE In the &GLOBAL section
&MOTION

    &GEO_OPT
        OPTIMIZER BFGS
        MAX_ITER  100
        MAX_DR    [bohr] 0.003
        &BFGS
        &END
    &END

    &MD

        ENSEMBLE NVT
        TEMPERATURE [K] 300
        TIMESTEP [fs] 0.5
        STEPS 2000

        &THERMOSTAT
            REGION MASSIVE
            TYPE GLE
            &GLE
                NDIM 5
                A_SCALE [ps^-1] 1.00
                A_LIST    1.859575861256e+2   2.726385349840e-1   1.152610045461e+1  -3.641457826260e+1   2.317337581602e+2
                A_LIST   -2.780952471206e-1   8.595159180871e-5   7.218904801765e-1  -1.984453934386e-1   4.240925758342e-1
                A_LIST   -1.482580813121e+1  -7.218904801765e-1   1.359090212128e+0   5.149889628035e+0  -9.994926845099e+0
                A_LIST   -1.037218912688e+1   1.984453934386e-1  -5.149889628035e+0   2.666191089117e+1   1.150771549531e+1
                A_LIST    2.180134636042e+2  -4.240925758342e-1   9.994926845099e+0  -1.150771549531e+1   3.095839456559e+2
            &END GLE
        &END THERMOSTAT

    &END

    &PRINT
        &TRAJECTORY
            &EACH
                MD 1
            &END EACH
        &END TRAJECTORY
        &VELOCITIES OFF
        &END VELOCITIES
        &FORCES OFF
        &END FORCES
        &RESTART_HISTORY
            &EACH
                MD 500
            &END EACH
        &END RESTART_HISTORY
        &RESTART
            BACKUP_COPIES 3
            &EACH
                MD 1
            &END EACH
        &END RESTART
    &END PRINT
&END
